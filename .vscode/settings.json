{
    "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "go.toolsManagement.autoUpdate": true,
    "go.lintTool": "staticcheck",
    "go.lintOnSave": "package",
    "gopls": {
        "staticcheck": true,
        "vulncheck": "Imports"
    },
    "files.exclude": {
        "**/.DS_Store": true
    },
    "search.exclude": {
        "bin": true,
        "dist": true
    }
}